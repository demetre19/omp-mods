<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.demetre.omp-durable-launcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/libexec/omp-devin/launcher/restore.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>WatchPaths</key>
  <array>
    <string>__HOME__/.local/bin/omp</string>
  </array>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
